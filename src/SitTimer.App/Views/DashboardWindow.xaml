<Window x:Class="SitTimer.App.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:conv="clr-namespace:SitTimer.App.Converters"
        xmlns:vm="clr-namespace:SitTimer.App.ViewModels"
        Title="SitTimer" Height="520" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.Resources>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SubText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
        </Style>
        <!-- Session row templates -->
        <DataTemplate x:Key="StandaloneTemplate" DataType="{x:Type vm:StandaloneSessionItem}">
            <Grid Height="32" Background="#1E1E2E" Grid.IsSharedSizeScope="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" SharedSizeGroup="Col0"/>
                    <ColumnDefinition Width="80" SharedSizeGroup="Col1"/>
                    <ColumnDefinition Width="80" SharedSizeGroup="Col2"/>
                    <ColumnDefinition Width="*" SharedSizeGroup="Col3"/>
                    <ColumnDefinition Width="80" SharedSizeGroup="Col4"/>
                    <ColumnDefinition Width="60" SharedSizeGroup="Col5"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Visibility="{Binding CanSelect, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Grid.Column="1" Text="{Binding Start}" Foreground="#CDD6F4" VerticalAlignment="Center" Padding="8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding End}" Foreground="#CDD6F4" VerticalAlignment="Center" Padding="8,0"/>
                <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="#CDD6F4" VerticalAlignment="Center" Padding="8,0"/>
                <TextBlock Grid.Column="4" Text="{Binding Break}" Foreground="#A6E3A1" VerticalAlignment="Center" Padding="8,0"/>
                <Button Grid.Column="5" Content="&#x2715;" Command="{Binding DeleteCommand}"
                        Background="Transparent" Foreground="#F38BA8" BorderThickness="0" Cursor="Hand" FontSize="12"
                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupHeaderTemplate" DataType="{x:Type vm:MergeGroupHeaderItem}">
            <StackPanel>
                <Grid Height="32" Background="#252540">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" SharedSizeGroup="Col0"/>
                        <ColumnDefinition Width="80" SharedSizeGroup="Col1"/>
                        <ColumnDefinition Width="80" SharedSizeGroup="Col2"/>
                        <ColumnDefinition Width="*" SharedSizeGroup="Col3"/>
                        <ColumnDefinition Width="80" SharedSizeGroup="Col4"/>
                        <ColumnDefinition Width="60" SharedSizeGroup="Col5"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{Binding ExpandArrow}" Command="{Binding ToggleExpandCommand}"
                            Background="Transparent" Foreground="#CDD6F4" BorderThickness="0" Cursor="Hand" FontSize="10"
                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Start}" Foreground="#CDD6F4" FontWeight="SemiBold" VerticalAlignment="Center" Padding="8,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding End}" Foreground="#CDD6F4" FontWeight="SemiBold" VerticalAlignment="Center" Padding="8,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="#CDD6F4" FontWeight="SemiBold" VerticalAlignment="Center" Padding="8,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding Break}" Foreground="#A6E3A1" FontWeight="SemiBold" VerticalAlignment="Center" Padding="8,0"/>
                    <Button Grid.Column="5" Content="Unmerge" Command="{Binding UnmergeCommand}"
                            Background="Transparent" Foreground="#89B4FA" BorderThickness="0" Cursor="Hand" FontSize="10"
                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
                <!-- Expanded children -->
                <ItemsControl ItemsSource="{Binding Children}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MergeGroupChildItem}">
                            <Grid Height="28" Background="#1E1E2E">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" SharedSizeGroup="Col0"/>
                                    <ColumnDefinition Width="80" SharedSizeGroup="Col1"/>
                                    <ColumnDefinition Width="80" SharedSizeGroup="Col2"/>
                                    <ColumnDefinition Width="*" SharedSizeGroup="Col3"/>
                                    <ColumnDefinition Width="80" SharedSizeGroup="Col4"/>
                                    <ColumnDefinition Width="60" SharedSizeGroup="Col5"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="2" Background="#45475A" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Start}" Foreground="#A6ADC8" VerticalAlignment="Center" Padding="8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding End}" Foreground="#A6ADC8" VerticalAlignment="Center" Padding="8,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="#A6ADC8" VerticalAlignment="Center" Padding="8,0"/>
                                <TextBlock Grid.Column="4" Text="{Binding Break}" Foreground="#7DAA7D" VerticalAlignment="Center" Padding="8,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GroupChildTemplate" DataType="{x:Type vm:MergeGroupChildItem}">
            <!-- Standalone child template (not used directly — children are nested in GroupHeaderTemplate) -->
            <Grid Height="28" Background="#1E1E2E">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="{Binding Start}" Foreground="#A6ADC8" VerticalAlignment="Center" Padding="8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding End}" Foreground="#A6ADC8" VerticalAlignment="Center" Padding="8,0"/>
                <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="#A6ADC8" VerticalAlignment="Center" Padding="8,0"/>
                <TextBlock Grid.Column="4" Text="{Binding Break}" Foreground="#7DAA7D" VerticalAlignment="Center" Padding="8,0"/>
            </Grid>
        </DataTemplate>

        <conv:SessionDisplayTemplateSelector x:Key="SessionTemplateSelector"
            StandaloneTemplate="{StaticResource StandaloneTemplate}"
            GroupHeaderTemplate="{StaticResource GroupHeaderTemplate}"
            GroupChildTemplate="{StaticResource GroupChildTemplate}"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab row -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource TabButton}" Content="Export"
                    Command="{Binding ExportCommand}"/>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource TabButton}" Content="Day"   Command="{Binding SelectDayCommand}"   Margin="0,0,4,0"/>
                <Button Style="{StaticResource TabButton}" Content="Week"  Command="{Binding SelectWeekCommand}"  Margin="0,0,4,0"/>
                <Button Style="{StaticResource TabButton}" Content="Month" Command="{Binding SelectMonthCommand}" Margin="0,0,4,0"/>
                <Button Style="{StaticResource TabButton}" Content="Year"  Command="{Binding SelectYearCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Navigation row -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource NavButton}" Content="&#8249;" Command="{Binding PreviousCommand}"/>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding HeaderText}" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource SubText}" Text="Sitting: "/>
                    <TextBlock Style="{StaticResource SubText}" Text="{Binding TotalText}" Margin="0,0,16,0"/>
                    <TextBlock Style="{StaticResource SubText}" Text="Break: "/>
                    <TextBlock Text="{Binding TotalBreakText}" Foreground="#A6E3A1" FontSize="13"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource NavButton}" Content="&#8250;" Command="{Binding NextCommand}"/>
        </Grid>

        <!-- Reminder setting footer -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Remind me after"
                       Style="{StaticResource SubText}"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="2"
                     Text="{Binding ReminderMinutes, UpdateSourceTrigger=PropertyChanged}"
                     Background="#313244" Foreground="#CDD6F4"
                     BorderThickness="0" Padding="8,6"
                     TextAlignment="Center"
                     VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="minutes"
                       Style="{StaticResource SubText}"
                       VerticalAlignment="Center" Margin="8,0,12,0"/>
            <Button Grid.Column="4"
                    Style="{StaticResource TabButton}"
                    Content="Save"
                    Command="{Binding SaveReminderCommand}"/>
        </Grid>

        <!-- Min break setting -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Merge breaks shorter than"
                       Style="{StaticResource SubText}"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="2"
                     Text="{Binding MinBreakMinutes, UpdateSourceTrigger=PropertyChanged}"
                     Background="#313244" Foreground="#CDD6F4"
                     BorderThickness="0" Padding="8,6"
                     TextAlignment="Center"
                     VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="minutes"
                       Style="{StaticResource SubText}"
                       VerticalAlignment="Center" Margin="8,0,12,0"/>
            <Button Grid.Column="4"
                    Style="{StaticResource TabButton}"
                    Content="Save"
                    Command="{Binding SaveMinBreakCommand}"/>
        </Grid>

        <!-- Session table (Day view) -->
        <Grid Grid.Row="5" Grid.IsSharedSizeScope="True"
              Visibility="{Binding ShowTable, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Merge button bar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Merge Selected" Style="{StaticResource TabButton}"
                        Command="{Binding MergeSelectedCommand}"
                        IsEnabled="{Binding CanMerge}"/>
            </StackPanel>

            <!-- Column headers -->
            <Grid Grid.Row="1" Background="#181825" Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" SharedSizeGroup="Col0"/>
                    <ColumnDefinition Width="80" SharedSizeGroup="Col1"/>
                    <ColumnDefinition Width="80" SharedSizeGroup="Col2"/>
                    <ColumnDefinition Width="*" SharedSizeGroup="Col3"/>
                    <ColumnDefinition Width="80" SharedSizeGroup="Col4"/>
                    <ColumnDefinition Width="60" SharedSizeGroup="Col5"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Start" Foreground="#A6ADC8" VerticalAlignment="Center" Padding="8,0"/>
                <TextBlock Grid.Column="2" Text="End" Foreground="#A6ADC8" VerticalAlignment="Center" Padding="8,0"/>
                <TextBlock Grid.Column="3" Text="Duration" Foreground="#A6ADC8" VerticalAlignment="Center" Padding="8,0"/>
                <TextBlock Grid.Column="4" Text="Break" Foreground="#A6ADC8" VerticalAlignment="Center" Padding="8,0"/>
            </Grid>

            <!-- Session list -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sessions}"
                              ItemTemplateSelector="{StaticResource SessionTemplateSelector}"/>
            </ScrollViewer>
        </Grid>

        <!-- Bar chart (Week / Month / Year views) -->
        <lvc:CartesianChart x:Name="BarChart"
                            Grid.Row="5"
                            Visibility="{Binding ShowTable, Converter={StaticResource InverseBoolToVisibility}}"
                            Series="{Binding ChartSeries}"
                            XAxes="{Binding XAxes}"
                            Background="#1E1E2E"/>
    </Grid>
</Window>
